# --- Database ---
# Local dev default (SQLite file, zero setup). For production, point this at
# Postgres/MySQL instead (Vercel Postgres, Supabase, Neon, PlanetScale, ...)
# and change the datasource provider in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# --- Auth (admin backend login) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Shop info ---
NEXT_PUBLIC_SHOP_NAME="樂美"
NEXT_PUBLIC_SHOP_NAME_EN="LE MEI"
NEXT_PUBLIC_SHOP_PHONE="02-1234-5678"
# Confirm the exact hours before launch — placeholder only.
NEXT_PUBLIC_SHOP_HOURS="10:00–22:00"

# --- Online payment (optional) ---
# Leave these blank to run in "pay at store" mode only. Fill them in once you
# have a Stripe account (or swap lib/payment.ts for ECPay/藍新/TapPay) to turn
# on real online deposit/payment collection during checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
